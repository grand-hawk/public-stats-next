    "@swc/helpers": "^0.5.23",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/slug": "^5.0.9",
    "@types/stale-lru-cache": "^5.1.6",
    "@types/umami-browser": "^2.18.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
