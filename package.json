{
  "name": "public-stats-next",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "build:analyze": "cross-env ANALYZE=true pnpm run build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "eslint": "eslint .",
    "lint": "pnpm run typecheck && pnpm run eslint",
    "format": "prettier . -w",
    "fix": "pnpm run eslint --fix && pnpm run format",
    "content:generate": "tsx scripts/generate-content.mts",
    "content:validate": "tsx scripts/validate-content.mts",
    "related:check": "tsx scripts/check-related-pages.mts",
    "generate-armor-thumbnails": "tsx scripts/generate-armor-thumbnails.mts",
    "generate": "rimraf generated && cross-env NODE_ENV=development tsx scripts/generate/index.mts 1.0.0",
    "postinstall": "node scripts/run-if-missing.mjs generated \"pnpm run generate\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@chakra-ui/charts": "^3.36.1",
