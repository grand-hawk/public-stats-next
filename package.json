    "markdown-table": "^3.0.4",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "node-html-parser": "^9.0.1",
    "nuqs": "^2.9.6",
    "prettier": "^3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remove-markdown": "^0.6.4",
    "shiki": "^4.4.3",
